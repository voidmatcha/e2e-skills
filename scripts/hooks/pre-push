#!/bin/bash -p
# pre-push: refresh the local e2e-skills install from the current working tree,
# including any uncommitted edits present when the hook runs.
# Delegates to scripts/dev/reinstall-skills.sh, which runs:
#   `skills remove` (no-op if not installed) + `skills add --copy` (idempotent).
# This handles both initial install (first push) and refresh (subsequent pushes).
# Wired in by scripts/dev/install-hooks.sh (sets core.hooksPath=scripts/hooks).
builtin set -euo pipefail

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
builtin export PATH
builtin unset CDPATH ENV BASH_ENV GLOBIGNORE
while IFS= builtin read -r imported_function; do
  builtin unset -f "$imported_function"
done < <(builtin compgen -A function)
builtin shopt -u expand_aliases
builtin unalias -a 2>/dev/null || true

REPO_ROOT="$(/usr/bin/git rev-parse --show-toplevel)"

echo "==> pre-push: README i18n parity guard"
en_sec=$(grep -c '^## ' "$REPO_ROOT/README.md" || true)
en_fence=$(grep -c '^```' "$REPO_ROOT/README.md" || true)
for f in README.ko.md README.ja.md README.zh-cn.md; do
  s=$(grep -c '^## ' "$REPO_ROOT/$f" 2>/dev/null || true)
  c=$(grep -c '^```' "$REPO_ROOT/$f" 2>/dev/null || true)
  if [ "${s:-0}" != "$en_sec" ] || [ "${c:-0}" != "$en_fence" ]; then
    echo "pre-push: README i18n parity failed for $f (sections ${s:-0} vs $en_sec, fences ${c:-0} vs $en_fence)." >&2
    echo "pre-push: translations drifted from README.md — sync them before pushing." >&2
    exit 1
  fi
done

echo "==> pre-push: running local security/manifest gate"
/bin/bash -p "$REPO_ROOT/scripts/ci/pre-push-security.sh" --quiet

# Catch what CI would reject, before the push instead of after: version/surface parity,
# pattern-severity parity, subagent parity, link integrity, docs orphans, language, and the
# skill-description budget. review.sh is the fast subset of ci-local (no eval/drift-smoke run),
# so it stays in the seconds range and does not make pushing painful.
# WARNINGS are informational and never block; only errors do. Set E2E_SKILLS_SKIP_REVIEW=1 to
# bypass in an emergency (CI still enforces it).
if [ "${E2E_SKILLS_SKIP_REVIEW:-}" = "1" ]; then
  echo "==> pre-push: review gate skipped by E2E_SKILLS_SKIP_REVIEW=1"
else
  echo "==> pre-push: running review gate (parity, links, language, description budget)"
  if ! "$REPO_ROOT/scripts/ci/review.sh" --quiet; then
    echo "pre-push: review.sh reported errors — fix them or re-run with E2E_SKILLS_SKIP_REVIEW=1." >&2
    exit 1
  fi
fi

echo "==> pre-push: refreshing local e2e-skills install"
"$REPO_ROOT/scripts/dev/reinstall-skills.sh"
