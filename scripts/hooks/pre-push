#!/bin/bash -p
# pre-push: run the local gates, then refresh the local e2e-skills install.
# The refresh copies the working tree, not the pushed ref, so it runs only when
# the push sends the checked-out HEAD to main and skills/ has no uncommitted
# edits; otherwise the installed copy could differ from what was pushed.
# Delegates to scripts/dev/reinstall-skills.sh, which runs:
#   `skills remove` (no-op if not installed) + `skills add --copy` (idempotent).
# This handles both initial install (first push) and refresh (subsequent pushes).
# Wired in by scripts/dev/install-hooks.sh (sets core.hooksPath=scripts/hooks).
builtin set -euo pipefail

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
builtin export PATH
builtin unset CDPATH ENV BASH_ENV GLOBIGNORE
while IFS= builtin read -r imported_function; do
  builtin unset -f "$imported_function"
done < <(builtin compgen -A function)
builtin shopt -u expand_aliases
builtin unalias -a 2>/dev/null || true

REPO_ROOT="$(/usr/bin/git rev-parse --show-toplevel)"
# Git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# pushed ref on stdin. Read it before anything else can consume stdin.
PUSHED_REFS="$(/bin/cat)"

echo "==> pre-push: README i18n parity guard"
en_sec=$(grep -c '^## ' "$REPO_ROOT/README.md" || true)
en_fence=$(grep -c '^```' "$REPO_ROOT/README.md" || true)
for f in README.ko.md README.ja.md README.zh-cn.md; do
  s=$(grep -c '^## ' "$REPO_ROOT/$f" 2>/dev/null || true)
  c=$(grep -c '^```' "$REPO_ROOT/$f" 2>/dev/null || true)
  if [ "${s:-0}" != "$en_sec" ] || [ "${c:-0}" != "$en_fence" ]; then
    echo "pre-push: README i18n parity failed for $f (sections ${s:-0} vs $en_sec, fences ${c:-0} vs $en_fence)." >&2
    echo "pre-push: translations drifted from README.md — sync them before pushing." >&2
    exit 1
  fi
done

echo "==> pre-push: running local security/manifest gate"
/bin/bash -p "$REPO_ROOT/scripts/ci/pre-push-security.sh" --quiet

# Catch what CI would reject, before the push instead of after: version/surface parity,
# pattern-severity parity, subagent parity, link integrity, docs orphans, language, and the
# skill-description budget. review.sh is the fast subset of ci-local (no eval/drift-smoke run),
# so it stays in the seconds range and does not make pushing painful.
# WARNINGS are informational and never block; only errors do. Set E2E_SKILLS_SKIP_REVIEW=1 to
# bypass in an emergency (CI still enforces it).
if [ "${E2E_SKILLS_SKIP_REVIEW:-}" = "1" ]; then
  echo "==> pre-push: review gate skipped by E2E_SKILLS_SKIP_REVIEW=1"
else
  echo "==> pre-push: running review gate (parity, links, language, description budget)"
  if ! "$REPO_ROOT/scripts/ci/review.sh" --quiet; then
    echo "pre-push: review.sh reported errors — fix them or re-run with E2E_SKILLS_SKIP_REVIEW=1." >&2
    exit 1
  fi
fi

# Local ci-local.sh runs on macOS; the skills' scripts also ship to Linux. When
# a pushed range touches them, run their suites in a pinned Ubuntu image.
# No Docker is a warning, not a failure, so local gates stay dependency-free.
# Set E2E_SKILLS_SKIP_LINUX_CHECK=1 to bypass (hosted CI still runs Linux).
ZERO_SHA="0000000000000000000000000000000000000000"
linux_check_revs=""
while IFS=' ' builtin read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] && [ "$local_sha" != "$ZERO_SHA" ] || continue
  if [ "$remote_sha" = "$ZERO_SHA" ] ||
     ! /usr/bin/git -C "$REPO_ROOT" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$(/usr/bin/git -C "$REPO_ROOT" merge-base "$local_sha" origin/main 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  # Capture instead of piping into grep -q: under pipefail an early grep exit
  # can kill git diff with SIGPIPE and silently skip the check.
  changed=""
  if [ -n "$base" ]; then
    changed="$(/usr/bin/git -C "$REPO_ROOT" diff --name-only "$base" "$local_sha" -- \
      'skills/*/scripts/*' scripts/ci/test-reviewer-scanner.py scripts/ci/test-debugger-contracts.py \
      'scripts/ci/test-*-debugger-*.py')" || changed="unknown"
  fi
  if [ -z "$base" ] || [ -n "$changed" ]; then
    case " $linux_check_revs " in
      *" $local_sha "*) ;;
      *) linux_check_revs="$linux_check_revs $local_sha" ;;
    esac
  fi
done <<< "$PUSHED_REFS"

if [ -z "$linux_check_revs" ]; then
  :
elif [ "${E2E_SKILLS_SKIP_LINUX_CHECK:-}" = "1" ]; then
  echo "==> pre-push: Linux script check skipped by E2E_SKILLS_SKIP_LINUX_CHECK=1"
else
  for linux_check_rev in $linux_check_revs; do
    echo "==> pre-push: shipped scripts changed; running Linux script check on ${linux_check_rev:0:7}"
    set +e
    "$REPO_ROOT/scripts/dev/linux-script-check.sh" "$linux_check_rev"
    linux_status=$?
    set -e
    if [ "$linux_status" -eq 1 ]; then
      echo "pre-push: a shipped-script suite fails on Linux — fix it or re-run with E2E_SKILLS_SKIP_LINUX_CHECK=1." >&2
      exit 1
    elif [ "$linux_status" -ne 0 ]; then
      echo "pre-push: WARNING: Linux script check could not run (exit $linux_status); hosted CI will still run it." >&2
    fi
  done
fi

HEAD_SHA="$(/usr/bin/git -C "$REPO_ROOT" rev-parse HEAD)"
pushes_head_to_main=0
while IFS=' ' builtin read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" = "$HEAD_SHA" ]; then
    pushes_head_to_main=1
  fi
done <<< "$PUSHED_REFS"

if [ "$pushes_head_to_main" != "1" ]; then
  echo "==> pre-push: local install refresh skipped (this push does not send the checked-out HEAD to main)"
elif [ -n "$(/usr/bin/git -C "$REPO_ROOT" status --porcelain -- skills)" ]; then
  echo "==> pre-push: local install refresh skipped (skills/ has uncommitted changes that were not pushed)"
else
  echo "==> pre-push: refreshing local e2e-skills install"
  "$REPO_ROOT/scripts/dev/reinstall-skills.sh"
fi
