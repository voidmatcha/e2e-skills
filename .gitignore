.DS_Store
__pycache__/
*.pyc
.serena
.agents/
.claude/
.sisyphus/
.handover/
docs/superpowers/
testbed/
results/
# Scratch dirs that other local campaigns (e.g. ui-clone) drop relative to CWD
/tmp/
/$PWD/

# Eval fixtures are committed: assertions cite exact file:line and must be reproducible
# from a fresh clone. The scanner excludes **/evals/files/** in all three tiers, so the
# intentional anti-patterns inside them cannot fail the repo's own smell-scan CI gate.

# Eval run results (benchmarks, grading, timing)
*-workspace/
.serena/

# test-parity.sh transient backups (stray after an interrupted run)
*.parity-backup

# Marketing collateral (local-only, not part of the public repo)
marketing/
/.github/marketing-strategy.md

# Local-only skill verification harness: hardcodes machine-specific testbed/ paths
# and pairs with the .claude/commands/verify-reviewer slash command. Not portable to
# a fresh clone, so kept out of the shared tree.
scripts/dev/smoke-reviewer.sh

# Local tokensave tool state (carries a multi-megabyte SQLite database)
.tokensave/

# Dependency trees and virtualenvs. scripts/evals/fixtures has its own rule, but
# a tree created anywhere else would otherwise be committed. The pinned
# scripts/evals/tokenizer-cache/ is deliberately NOT covered here: the review
# harnesses bind it by digest, so it has to stay in the tree.
node_modules/
.venv/
venv/

# Private Codex authentication snapshots retained by bounded local eval runs.
**/.codex/auth.json

# Runtime state locks the independent-review runner creates beside an archive
benchmarks/.*.state.lock

# Nested-project scan roots test-reviewer-scanner.py builds in the repository
# root. Its context manager cleans up on exception but not on SIGKILL, and the
# leftover carries a deliberate `test.only` fixture the repo's own scan cannot
# flag, so an orphan must never become a committable file.
/.e2e-reviewer-nested-project-*/

# Live generator fixture: run it from a copy; never keep its runner output here.
scripts/evals/generator-live/*/test-results/
scripts/evals/generator-live/*/playwright-report/

# claude plugin eval run output
/evals/results/
/test-results/

# Raw run artifacts moved to the external dataset in 2.0.1 (see
# benchmarks/external-evidence.json). Fetch them with
# scripts/dev/fetch-benchmark-evidence.sh; they must never be committed back.
/benchmarks/healer-perturbation-v1/healer-artifacts-codex/
/benchmarks/healer-perturbation-v1/healer-artifacts-codex-r10/
/benchmarks/healer-perturbation-v1/healer-artifacts-codex-r11/
/benchmarks/healer-perturbation-v1/healer-artifacts-codex-r12/
