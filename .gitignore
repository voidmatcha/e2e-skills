.DS_Store
__pycache__/
*.pyc
.serena
.agents/
.claude/
.sisyphus/
.handover/
docs/superpowers/
testbed/
results/
# Scratch dirs that other local campaigns (e.g. ui-clone) drop relative to CWD
/tmp/
/$PWD/

# Eval fixtures are committed: assertions cite exact file:line and must be reproducible
# from a fresh clone. The scanner excludes **/evals/files/** in all three tiers, so the
# intentional anti-patterns inside them cannot fail the repo's own smell-scan CI gate.

# Eval run results (benchmarks, grading, timing)
*-workspace/
.serena/

# test-parity.sh transient backups (stray after an interrupted run)
*.parity-backup

# Marketing collateral (local-only, not part of the public repo)
marketing/

# Local-only skill verification harness: hardcodes machine-specific testbed/ paths
# and pairs with the .claude/commands/verify-reviewer slash command. Not portable to
# a fresh clone, so kept out of the shared tree.
scripts/dev/smoke-reviewer.sh

# Local tokensave tool state (carries a multi-megabyte SQLite database)
.tokensave/

# Dependency trees and virtualenvs. scripts/evals/fixtures has its own rule, but
# a tree created anywhere else would otherwise be committed. The pinned
# scripts/evals/tokenizer-cache/ is deliberately NOT covered here: the review
# harnesses bind it by digest, so it has to stay in the tree.
node_modules/
.venv/
venv/

# Runtime state locks the independent-review runner creates beside an archive
benchmarks/.*.state.lock
