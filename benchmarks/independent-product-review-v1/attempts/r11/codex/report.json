        "severity": "M",
        "category": "semantic_correctness",
        "file": "skills/e2e-reviewer/scripts/scan.sh",
        "line": 1843,
        "title": "Undocumented mandatory Python dependency",
        "evidence": "Candidate fingerprinting returns failure when no bound Python 3 executable exists, and the mandatory manifest-recording path converts that failure into exit 2. This conflicts with the included public guidance that identifies PCRE2-capable ripgrep as the bundled scanner requirement and describes Python only for optional Tier 2 validation.",
        "recommendation": "Document Python 3 as a mandatory Tier 3 scanner prerequisite, or implement the candidate-identity baseline without requiring Python and retain Python only for optional tiers."
      },
      {
        "severity": "M",
        "category": "scope_contract_consistency",
        "file": "skills/e2e-reviewer/SKILL.md",
        "line": 20,
        "title": "Framework detection narrows the shared extension scope",
        "evidence": "Phase 0 instructs reviewers to inspect actual imports only in `.ts` and `.js` files, while the included scanner and generator contracts support `.tsx`, `.jsx`, `.mts`, `.mjs`, `.cts`, and `.cjs` as well. A suite using those forms can therefore be misclassified before framework-specific checks run.",
        "recommendation": "Use the same eight-extension set for Phase 0 framework detection and state it once as a shared contract."
      },
      {
        "severity": "M",
        "category": "scope_contract_consistency",
        "file": "skills/playwright-debugger/SKILL.md",
        "line": 266,
        "title": "Playwright diagnosis omits supported config forms",
        "evidence": "The required configuration read is limited to `playwright.config.{ts,js}`, despite included public surfaces recognizing additional JavaScript/TypeScript forms. Retry, parallelism, baseURL, timeout, and webServer evidence can consequently be missed for supported configurations.",
        "recommendation": "Require discovery of Playwright configuration across the shared supported extension set before F1, F7, or F8 classification."
      },
      {
        "severity": "M",
        "category": "scope_contract_consistency",
        "file": "skills/cypress-debugger/SKILL.md",
        "line": 323,
        "title": "Cypress diagnosis omits supported config forms",
        "evidence": "The classification procedure requires only `cypress.config.{js,ts}` even though the included scanner's project boundary recognizes `.mts`, `.mjs`, `.cts`, and `.cjs` Cypress configurations. This can omit retries, isolation, timeout, and baseUrl evidence.",
        "recommendation": "Align Cypress configuration discovery with the scanner's complete recognized configuration set."
      },
      {
        "severity": "M",
        "category": "docs_usability",
        "file": "skills/playwright-test-generator/SKILL.md",
        "line": 323,
        "title": "ARIA fallback rejects valid loopback aliases without advance notice",
        "evidence": "The fallback accepts only literal `localhost`, `127.0.0.1`, or `::1` hostnames, although the preceding preflight contract permits an approved hostname whose entire DNS set is loopback. A local alias such as an approved development hostname can pass preflight and then fail only inside the fallback.",
        "recommendation": "Either validate the approved DNS snapshot in the fallback and accept all-loopback aliases, or disclose the literal-host restriction before preflight and provide the exact remediation."
      }
