    "findings": [
      {
        "severity": "H",
        "category": "security_trust_boundaries",
        "file": "skills/playwright-test-generator/SKILL.md",
        "line": 331,
        "title": "Raw-ARIA fallback inherits ambient environment",
        "evidence": "The documented command launches project-installed Playwright with `TARGET_URL=... node -e` but no empty-environment or variable allowlist. Because the following code imports the project's `@playwright/test`, approved target-controlled code can read all inherited credentials and configuration, unlike the debugger command boundaries that use `/usr/bin/env -i`.",
        "recommendation": "Launch the fallback through a bundled helper using an empty environment, an absolute trusted Node executable, and an explicit allowlist containing only the validated target URL and required non-secret runtime variables."
      },
      {
        "severity": "M",
        "category": "verification_design",
        "file": "skills/playwright-test-generator/SKILL.md",
        "line": 583,
        "title": "Completion treatment of V2 and V3 is ambiguous",
        "evidence": "This completion rule explicitly makes applicable V4 or V5 `CANNOT_VERIFY` blocking, while V2 and V3 are also prescribed verification steps and the separate verification contract says every applicable rule must pass. The included contracts therefore do not unambiguously determine whether an applicable V2 or V3 `CANNOT_VERIFY` permits `Complete`.",
        "recommendation": "Define one completion matrix covering every V1\u2013V6 verdict, explicitly stating whether each applicable `CANNOT_VERIFY`, `ERROR`, and `FAIL` blocks completion."
      },
      {
        "severity": "M",
        "category": "security_trust_boundaries",
        "file": "README.md",
        "line": 203,
        "title": "Manual installation tracks an unpinned branch",
        "evidence": "The manual path clones the repository without a tag or commit and immediately exposes its skill directories through persistent symlinks. This can activate later, unreviewed changes despite the adjacent installation guidance emphasizing version pinning to avoid executing unreviewed releases.",
        "recommendation": "Clone a documented release tag or commit by default and provide an explicit reviewed upgrade procedure."
      }
    ],
