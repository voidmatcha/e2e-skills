  "review": {
    "summary": "The subset defines strong fail-closed scanning, artifact parsing, verification, and false-positive controls, but three execution and artifact-origin trust gaps materially contradict its secure-default boundaries.",
    "scores": {
      "semantic_correctness": 91,
