+class NativeRootSpawns(unittest.TestCase):
+    fixture = ROOT / "benchmarks/generator-multimodel-v2-codex/fixtures/harness-check"
+
+    def observe(self, root):
+        rec = json.loads((root / "call.json").read_text())
+        tdir = root / "transcripts"
+        return m.classify_fidelity(rec, tdir), m.tokens_for_record(rec, tdir), m.evaluate_harness_check(rec, tdir)
+
+    def test_scrubbed_real_pair_with_blind_stream_is_complete(self):
+        fid, cost, check = self.observe(self.fixture)
+        self.assertEqual(check["status"], "pass")
+        self.assertTrue(check["criteria"]["spawns_have_rollouts"])
+        self.assertEqual((check["info"]["spawns_in_parent_stream"], check["info"]["spawn_source"],
+                          check["info"]["spawn_calls"], check["info"]["completed_spawns"], check["info"]["child_rollouts"]),
+                         (0, "root-rollout", 1, 1, 1))
+        self.assertEqual(fid["evidence"]["primary_signal"], "rollout-absence")
+        self.assertTrue(fid["evidence"]["primary_signal_complete"])
+        self.assertTrue(cost["complete"])
+        self.assertEqual(cost["total"], 33329 + 21689)
+        rollouts = ev.load_sessions(self.fixture / "codex-sessions")
+        parent = next(r for r in rollouts if not r["parent_thread_id"])
+        self.assertEqual(parent["function_spawns"]["completed"], 1)  # wait_agent is not a spawn
+        self.assertEqual(parent["function_spawns"]["thread_ids"], [])  # real output has task_name only
+        raw = "".join(p.read_text() for p in self.fixture.rglob("*.jsonl"))
+        for forbidden in ("/" + "Users/", "/" + "home/", "encrypted", "instructions", "prompt", '"message"'):
+            self.assertNotIn(forbidden, raw)
