{
 "schema_version": 1,
 "protocol_id": "generator-skill-effect-v1",
 "evidence_scope": "public-development",
 "release_eligible": false,
 "hypothesis": "On a fresh small web project with a stated feature and acceptance criteria, a model following the playwright-test-generator skill (full workflow: exploration, scenario design, generation, e2e-reviewer gate, V1-V6 verification) writes Playwright E2E specs that detect more seeded application faults, while still passing on the correct application, than the same model with the same tools, approvals and task text but no skill.",
 "design_notes": "Tool-enabled, deterministic scoring, no model judge. Each call stages a fresh project (app.mjs, playwright.config.mjs with webServer on a loopback port, package.json, README.md, one existing spec, Playwright 1.62 from the pinned fixture lockfile, a Git baseline commit) and asks for E2E tests for one feature whose acceptance criteria are listed in the task. The model never sees a fault: faults are applied to copies of the correct app only at scoring time, one fault per stated criterion (plus one surface fault), so a test that verifies every stated criterion kills every fault and a test that verifies the happy path only does not. Nothing shown to the model names a fault, a fault class, or this benchmark. The ten cases are new for this benchmark; none reuses the archived counter fixture, the writescope-demo todo app, or any case of the generator's own evals or the debugger benchmarks.",
 "arms": {
  "skill": "same prompt, tools, approvals and project, plus an instruction to read and follow the working-tree playwright-test-generator skill (SKILL.md and its reference files), staged outside the project together with the working-tree e2e-reviewer skill that its Step 6 invokes (the Skill tool is unavailable in this harness, so the skill's own inline-fallback instruction applies)",
  "no-skill": "same prompt, tools, approvals and project; no skill files staged"
 },
 "host": {
  "runner": "claude",
  "requested_model": "claude-sonnet-5-5",
  "tools": "Read,Grep,Glob,Bash,Write,Edit,Agent",
  "settings": "none (--setting-sources '', --strict-mcp-config, --no-session-persistence)",
  "second_model_family": "not run: Codex exec cannot be given the same tool surface (file writes plus a loopback browser under its sandbox) without a separate harness; a single-host result is a stated limit of v1"
 },
 "repetitions": 3,
 "workers": 2,
 "seed": 20261005,
 "spend_cap_usd": 90,
 "per_call_budget_usd": 4.0,
 "timeout_s": 1500,
 "agent_outcomes": "a call that hits its wall-clock limit or its per-call budget is scored on whatever spec files exist in tests/ at that moment (usually none, scoring 0) and counted in the arm's timeout metric; it is not retried",
 "infrastructure_retry": "one retry, in a fresh staged project, only for a CLI crash or a non-JSON envelope; a call that returns an envelope is never retried",
 "deliverable": "every new or modified file under tests/ at the end of the call (git status against the baseline commit); the spec files among them (*.spec.* or *.test.*) are the ones scored. A leftover temporary verifier spec counts as part of the deliverable. Writes outside tests/ are recorded and discarded: scoring always uses the original app.mjs and playwright.config.mjs",
 "scoring": {
  "clean": "the spec files pass on the correct app in 3 of 3 separate runs (fresh server each run)",
  "fault_kill": "a fault variant is killed when at least one test fails on it with no Playwright-level error (webServer, syntax)",
  "refactor_survival": "the spec files pass on a behavior-preserving markup refactor (ids, classes and nesting renamed; roles, labels, names and text unchanged); reported only for clean deliverables",
  "smells": "skills/e2e-reviewer/scripts/scan.sh on the delivered tests files alone; P0 and P1/P2-heuristic counts (LLM-triage hits reported separately, not as findings)",
  "cost": "total_cost_usd, num_turns, usage and wall time from the Claude Code envelope"
 },
 "primary_metric": "effective fault-kill rate per call: faults killed / faults seeded, counted 0 when the deliverable is not clean (or absent)",
 "secondary_metrics": [
  "deliverable rate, clean-pass rate, flaky calls (some but not all clean runs pass), timeouts",
  "fault-kill rate given clean, by fault class (surface, precision, persistence, interaction, boundary)",
  "refactor survival given clean",
  "scanner P0 total and P1/P2 heuristic mean per scanned call",
  "cost, turns, tokens and wall time per arm; the skill/no-skill cost multiple is reported, not gated"
 ],
 "fault_classes": {
  "surface": "the happy path visibly breaks; any test of the feature should fail",
  "precision": "a stated detail is wrong (exact text, count, order, absence, which item changed); only an assertion of that detail fails",
  "persistence": "the page shows success but the server did not store (or did not drop) the change; only a re-read after reload, an API read, or a response check fails",
  "interaction": "a stated keyboard, focus, enabled/disabled or clear-after-success behavior is missing",
  "boundary": "a stated limit is off by one or an edge state is wrong"
 },
 "headroom_rule": "before freeze, every case must pass `validate`: the existing spec stays green under every fault, an author-written strong spec passes the correct app twice, kills every fault and survives the refactor, and an author-written naive happy-path spec misses at least two faults. The naive spec is never shown to a model.",
 "decision_rule": {
  "min_lift": 0.1,
  "ci": "paired case-cluster bootstrap of per-case mean primary differences (skill minus no-skill), 10000 resamples, seed above",
  "bootstrap_resamples": 10000,
  "max_clean_pass_drop": 0.05,
  "ceiling": 0.9,
  "PASS": "lift >= min_lift AND bootstrap 95% CI lower bound > 0 AND skill clean-pass rate >= no-skill clean-pass rate - max_clean_pass_drop AND no-skill primary < ceiling",
  "FAIL": "all 60 calls scored, no input drift, no spend-cap stop, no-skill primary below the ceiling, and PASS not met",
  "INCONCLUSIVE": "any unscored call, input drift, spend-cap stop, an incomplete schedule, or a no-skill primary at or above the ceiling"
 },
 "power": "No pilot variance exists for this metric. Assuming a per-case paired-difference SD of 0.25, ten cases give a standard error near 0.08 and a minimum detectable paired lift near 0.22 at 80% power (two-sided 0.05). A true lift of 0.10 would be detected well under half the time; a FAIL therefore means 'no large effect shown', not 'no effect'.",
 "contamination": "the ten cases and the smoke case were written for this protocol and are spent after this run; a rerun needs new cases and a new protocol version. The smoke case (smoke/gen-00) is outside the corpus and unscored.",
 "limits": [
  "One host and model family (Claude Code, claude-sonnet-5-5); three repetitions; ten author-written single-page apps with in-memory state.",
  "Faults are author-seeded, one per stated criterion: this measures whether the delivered tests verify what the task stated, not production fault prevalence.",
  "The skill is designed around an interactive approval gate; the harness grants every approval in advance in the shared prompt, so a skill call that still stops at the gate scores 0 and is reported as an outcome of the skill in headless use.",
  "The e2e-reviewer Skill-tool path is unavailable; the skill arm uses the skill's documented inline fallback, as a Codex install would.",
  "The scanner smell counts are mechanical (Tier 2/3) and are a secondary, not the primary."
 ],
