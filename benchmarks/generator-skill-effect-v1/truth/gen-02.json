{
  "task": "Add end-to-end tests for the product search page (`/`). Acceptance criteria: (1) typing in the search box narrows the list to the products whose name contains the typed text; (2) matching ignores letter case; (3) the status line reads `Showing N of 6 products` for the current list; (4) when nothing matches, the list is empty and `No products match` is shown; (5) Clear empties the search box and shows all six products again. The six product names are Alpine Jacket, Trail Runner Shoes, Canvas Tote, Merino Beanie, Rain Shell and Camp Mug.",
  "faults": [
    {
      "id": "f1-filter-noop",
      "class": "surface",
      "criterion": 1,
      "description": "Typing never narrows the list.",
      "find": "      return products.filter((p) => p.name.toLowerCase().includes(q.toLowerCase()));\n",
      "replace": "      return products.filter((p) => p.name.length > 0 || q);\n"
    },
    {
      "id": "f2-case-sensitive",
      "class": "boundary",
      "criterion": 2,
      "description": "Matching is case-sensitive: `jacket` matches nothing.",
      "find": "p.name.toLowerCase().includes(q.toLowerCase())",
      "replace": "p.name.includes(q)"
    },
    {
      "id": "f3-count-stale",
      "class": "precision",
      "criterion": 3,
      "description": "The status line always reads `Showing 6 of 6 products`.",
      "find": "\"Showing \" + matches.length + \" of \"",
      "replace": "\"Showing \" + products.length + \" of \""
    },
    {
      "id": "f4-empty-state-missing",
      "class": "precision",
      "criterion": 4,
      "description": "`No products match` never appears.",
      "find": "emptyEl.hidden = matches.length > 0;",
      "replace": "emptyEl.hidden = matches.length >= 0;"
    },
    {
      "id": "f5-clear-keeps-input",
      "class": "interaction",
      "criterion": 5,
      "description": "Clear restores the list but leaves the typed text in the search box.",
      "find": "      queryEl.value = \"\";\n      apply();\n",
      "replace": "      render(products);\n"
    }
  ],
  "refactor": [
    {"find": "<div id=\"ps-toolbar\">", "replace": "<section class=\"toolbar\"><div id=\"ps-toolbar\" class=\"toolbar__row\">"},
    {"find": "<button type=\"button\" id=\"ps-clear\">Clear</button>\n    </div>", "replace": "<button type=\"button\" id=\"ps-clear\" class=\"btn btn-secondary\"><span>Clear</span></button>\n    </div></section>"},
    {"find": "li.className = \"product\";", "replace": "li.className = \"card card--product\";"},
    {"find": "ps-query", "replace": "search-field"},
    {"find": "ps-clear", "replace": "reset-search"},
    {"find": "ps-count", "replace": "result-status"},
