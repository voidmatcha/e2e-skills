{
  "task": "Cover the checkout wizard (`/`) end to end. A shopper enters a shipping address, chooses a shipping method, reviews the order and confirms. The review step shows the items, the chosen shipping cost and the total. After confirming, the order number is shown and the order appears under Your orders, also after a reload. Going back to an earlier step keeps what the shopper typed. When payment is declined (the city `Failville` triggers it), the shopper stays on the review step, sees the message `Payment declined`, and nothing is ordered.",
  "faults": [
    {
      "id": "f1-confirm-noop",
      "class": "surface",
      "brief_phrase": "the order number is shown",
      "description": "Confirm order sends the request but the page never shows the confirmation.",
      "find": "      el(\"co-confirmation\").textContent = \"Order #\" + body.number + \" confirmed\";\n      show(\"done\");\n",
      "replace": "      void body.number;\n"
    },
    {
      "id": "f2-back-loses-address",
      "class": "recovery",
      "brief_phrase": "keeps what the shopper typed",
      "description": "Going back to the address step shows empty fields.",
      "find": "      if (step === \"shipping\" && state.address) {\n",
      "replace": "      if (step === \"shipping\" && state.address && false) {\n"
    },
    {
      "id": "f3-order-not-stored",
      "class": "persistence",
      "brief_phrase": "also after a reload",
      "description": "The server answers with an order number but does not store the order; Your orders is empty after a reload.",
      "find": "      orders.push(order);\n      return json(res, 201, order);\n",
      "replace": "      return json(res, 201, order);\n"
    },
    {
      "id": "f4-express-total-wrong",
      "class": "precision",
      "brief_phrase": "the chosen shipping cost and the total",
      "description": "The review total always adds the Standard cost, even when Express is chosen (the shipping line is right).",
      "find": "el(\"co-total\").textContent = \"Total: \" + money(subtotal + shipping.cost);",
      "replace": "el(\"co-total\").textContent = \"Total: \" + money(subtotal + methods.standard.cost);"
    },
    {
      "id": "f5-declined-order-stored",
      "class": "precision",
      "brief_phrase": "nothing is ordered",
      "description": "A declined payment still records the order on the server; it appears under Your orders after a reload.",
      "find": "      if (order.city === \"Failville\") {\n        return json(res, 402, { error: \"Payment declined\" });\n      }\n      nextNumber += 1;\n      orders.push(order);\n",
      "replace": "      nextNumber += 1;\n      orders.push(order);\n      if (order.city === \"Failville\") {\n        return json(res, 402, { error: \"Payment declined\" });\n      }\n"
    }
  ],
