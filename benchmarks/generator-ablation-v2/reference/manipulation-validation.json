{
 "protocol_id": "generator-ablation-v1",
 "method": "Detectors (regexes over the parent transcript) are scored against ground truth re-derived from the tool-call events: R and E by a shell parse of every command (the script or the browser command is executed, not merely named), L and P by the line range each cat/sed/head/tail/rg/Read call covers against the real file, V by a spawned reviewer agent whose brief mentions a review. Truth is a different computation from the regexes. Cells whose reads could not be resolved are counted as unresolved and excluded.",
 "tuning_note": "In-sample: the E, R and V detectors were edited after inspecting these same cells (and E and R again after an independent review found they matched lookups and syntax checks), so precision and recall here describe the fitted detectors on their development cells, not held-out performance. Most true negatives are first-party-generator or no-skill-like cells that never open skill files.",
 "sources": {
  "gpt-5.5 offgen-pilot-v1": {
   "runner": "codex",
   "dir": "~/.cache/e2e-skills-bench/offgen-pilot-v1",
   "final_json_sha256": "7951a98f7102367f9d3dfa8b78443fe6a06d093ca4d54fe30cd93ce8abf6e1dd",
   "cli": "codex-cli 0.159.3",
   "cells": 24,
   "arms": {
    "official-generator": 12,
    "ours-2.0.1": 12
   }
  },
  "claude-sonnet-5-5 multimodel-v1": {
   "runner": "claude",
   "dir": "~/.cache/e2e-skills-bench/multimodel-v1/claude-sonnet-5-5",
   "final_json_sha256": "f6de282ce90a28869d33262bbc18029b1dd62767bb27066b99f2b9e0f5f87837",
   "cli": "2.1.299 (Claude Code)",
   "cells": 36,
   "arms": {
    "official+reviewer": 12,
    "official-generator": 12,
    "ours-2.0.1": 12
   }
  }
 },
 "detectors": {
  "frozen": {
   "L": {
    "where": "tool_output",
    "regex": "Text-bearing elements without a role",
    "meaning": "the Selector Priority text was read (it exists only in variants that keep L)"
   },
   "E": {
    "where": "command",
    "regex": "(?:^|[;&|(\\n]|\\b(?:ba|z|da)?sh[ \\t]+(?:-[A-Za-z]+[ \\t]+)*-[A-Za-z]*c[ \\t]+['\"])[ \\t]*(?:(?:[A-Za-z_]\\w*=\\S*|command|exec|time|nohup|env(?:[ \\t]+-[uCS][ \\t]+\\S+|[ \\t]+-\\S+)*|timeout[ \\t]+\\S+)[ \\t]+)*(?:(?:npx|pnpm|yarn|bunx|npm)[ \\t]+(?:(?:-\\S+|exec|dlx)[ \\t]+)*)?(?:\\S*/)?playwright[ \\t]+cli\\b(?![^;&|\\n]*\\s(?:--help|-h)\\b)[^;&|\\n]*\\s(?:open|goto|snapshot)\\b|(?:^|[;&|(\\n]|\\b(?:ba|z|da)?sh[ \\t]+(?:-[A-Za-z]+[ \\t]+)*-[A-Za-z]*c[ \\t]+['\"])[ \\t]*(?:(?:[A-Za-z_]\\w*=\\S*|command|exec|time|nohup|env(?:[ \\t]+-[uCS][ \\t]+\\S+|[ \\t]+-\\S+)*|timeout[ \\t]+\\S+)[ \\t]+)*(?:(?:npx|pnpm|yarn|bunx|npm)[ \\t]+(?:(?:-\\S+|exec|dlx)[ \\t]+)*)?(?:\\S*/)?agent-browser[ \\t]+(?!(?:--help|-h|help)\\b)[a-z]|(?:^|[;&|(\\n]|\\b(?:ba|z|da)?sh[ \\t]+(?:-[A-Za-z]+[ \\t]+)*-[A-Za-z]*c[ \\t]+['\"])[ \\t]*(?:(?:[A-Za-z_]\\w*=\\S*|command|exec|time|nohup|env(?:[ \\t]+-[uCS][ \\t]+\\S+|[ \\t]+-\\S+)*|timeout[ \\t]+\\S+)[ \\t]+)*(?:\\S*/)?run-raw-aria-snapshot\\.sh(?![\\w.-])|\\b(?:ba|z|da)?sh[ \\t]+(?:(?:-(?![A-Za-z]*n)[A-Za-z]+|--[a-z-]+)[ \\t]+)*\\S*run-raw-aria-snapshot\\.sh(?![\\w.-])",
    "meaning": "a browser exploration command was started in command position (Playwright CLI open/goto/snapshot, agent-browser with a subcommand, or the raw-ARIA fallback script executed); help-only invocations, `which`/`command -v`/`type` lookups, `bash -n` syntax checks and cat/sed/rg of the scripts do not count"
   },
   "P": {
    "where": "tool_output",
    "regex": "Distinct risk:",
    "meaning": "the scenario-admission template of scenario-design.md was read (the file is deleted in variants that remove P)"
   },
   "R": {
    "where": "command",
    "regex": "\\b(?:ba|z|da)?sh[ \\t]+(?:(?:-(?![A-Za-z]*n)[A-Za-z]+|--[a-z-]+)[ \\t]+)*\\S*scan\\.sh(?![\\w.-])|(?:^|[;&|(\\n]|\\b(?:ba|z|da)?sh[ \\t]+(?:-[A-Za-z]+[ \\t]+)*-[A-Za-z]*c[ \\t]+['\"])[ \\t]*(?:(?:[A-Za-z_]\\w*=\\S*|command|exec|time|nohup|env(?:[ \\t]+-[uCS][ \\t]+\\S+|[ \\t]+-\\S+)*|timeout[ \\t]+\\S+)[ \\t]+)*(?:\\S*/)?scan\\.sh(?![\\w.-])",
    "meaning": "the scanner was executed (bash/sh [flags] <path>/scan.sh, or the script path itself in command position); reading, listing, grepping, `test -x` or `bash -n` on scan.sh does not count"
   },
   "V": {
    "where": "tool_output",
    "regex": "V6 VERDICT:\\s*(?:PASS|FAIL)",
    "meaning": "the independent re-review returned its verdict line to the parent. Reading verification-rules.md is NOT the signal: Step 4, which minus-V keeps, sends the writer to that file's Command effect labels"
   }
  },
  "provisional": {
   "L": {
    "where": "tool_output",
    "regex": "Text-bearing elements without a role"
   },
   "E": {
    "where": "command",
    "regex": "playwright\\s+cli\\b"
   },
   "P": {
    "where": "tool_output",
    "regex": "Distinct risk:"
   },
   "R": {
    "where": "command",
    "regex": "scan\\.sh"
   },
   "V": {
    "where": "tool_output",
    "regex": "V-RULE-CONTRACT|Completion status matrix"
   }
  }
 },
