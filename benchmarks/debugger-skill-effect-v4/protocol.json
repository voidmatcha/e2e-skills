{
 "schema_version": 1,
 "protocol_id": "debugger-skill-effect-v4",
 "evidence_scope": "public-development",
 "release_eligible": false,
 "design_notes": "Pilot of a tool-enabled arm on raw artifacts. Each call stages a Playwright project whose last run really failed (playwright-report/results.json and test-results/ come from an actual `playwright test` run), and the model has Read/Grep/Glob/Bash. Truth is seeded at build time and independent of the skill taxonomy: defect file and line, mechanism (neutral enum given to both arms), diagnosis, and the number of distinct root causes. Scoring is deterministic; there is no model judge. Cases are author-written, so this measures workflow value on constructed faults, not accuracy on real-world failures; v1-v3 remain the real-failure evidence.",
 "arms": {
  "skill": "same prompt, tools, legend and schema, plus an instruction to read and follow the working-tree playwright-debugger skill (staged outside the project; the skill's trusted launcher rejects an in-project copy)",
  "no-skill": "same prompt, tools, legend and schema; no skill file staged"
 },
 "host": {
  "runner": "claude",
  "requested_model": "sonnet",
  "tools": "Read,Grep,Glob,Bash",
  "settings": "none (--setting-sources '')"
 },
 "second_model_family": "not run in this pilot (see README)",
 "repetitions": 3,
 "seed": 20261007,
 "spend_cap_usd": 25,
 "per_call_budget_usd": 1.5,
 "timeout_s": 420,
 "infrastructure_retry": "one retry for timeout, nonzero exit, malformed envelope, missing structured output, or a preflight whose failing-test set differs from the frozen one; a schema-valid answer is never retried",
 "primary_metric": "full: for every seeded root cause some finding names the right file within 3 lines, with the right mechanism and diagnosis, and the number of findings equals the number of seeded root causes",
 "secondary_metrics": [
  "location only",
  "mechanism given location",
  "diagnosis given location",
  "root-cause count",
  "cost, turns, wall time per arm"
 ],
 "decision_rule": {
  "min_lift": 0.15,
  "ci": "paired case-cluster bootstrap of per-case mean full-match differences (skill minus no-skill)",
  "bootstrap_resamples": 10000,
  "max_diagnosis_drop": 0.05,
  "ceiling": 0.9,
  "PASS": "lift >= min_lift AND bootstrap 95% CI lower bound > 0 AND skill diagnosis rate >= no-skill diagnosis rate - max_diagnosis_drop AND no-skill full rate < ceiling",
  "FAIL": "all calls scored, no drift, no spend-cap stop, no-skill below the ceiling, and PASS not met",
  "INCONCLUSIVE": "any unscored call, input drift, spend-cap stop, or no-skill full rate at or above the ceiling (a ceiling-limited baseline cannot show a lift)"
 },
 "limits": [
  "12 author-written Playwright cases with seeded faults; Cypress not covered.",
  "One model family and host; three repetitions per case and arm.",
  "The skill arm must follow its safety gates and reader workflow, which costs turns and tokens; no cost-efficiency claim is made beyond the measured totals.",
  "The mechanism enum is shared by both arms but the skill's own vocabulary is the F1-F15 table, so the skill arm translates; this can cost it accuracy that would not exist in the skill's native format.",
  "Truth is constructed, not adjudicated by maintainers."
 ],
