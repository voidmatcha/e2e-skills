{
  "name": "@voidmatcha/e2e-skills-scanner",
  "version": "3.3.1",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "e2e-skills-scan": "src/cli.mjs",
    "e2e-skills-check": "src/check-cli.mjs",
    "e2e-skills": "src/setup-cli.mjs"
  },
  "exports": {
    "./check": "./src/check-candidates.mjs",
    "./report": "./src/report.mjs",
    "./inventory": "./src/inventory.mjs"
  },
  "files": [
    "src/",
    "guidance/",
    "scripts/run-probe.mjs",
    "examples/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "setup-runtime/",
    "scripts/build-setup-runtime.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:setup": "node scripts/build-setup-runtime.mjs",
    "check:setup": "node scripts/build-setup-runtime.mjs --check",
    "prepack": "node scripts/build-setup-runtime.mjs"
  },
  "dependencies": {
    "commander": "14.0.3",
    "typescript": "6.0.3"
  },
  "description": "Static Playwright and Cypress test review, configuration context, and explicit evidence-backed probes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidmatcha/e2e-skills.git",
    "directory": "packages/scanner"
  },
  "homepage": "https://github.com/voidmatcha/e2e-skills",
  "bugs": {
    "url": "https://github.com/voidmatcha/e2e-skills/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org"
  }
}
